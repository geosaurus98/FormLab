[
 {
  "title": "Beef & Lentil Bolognese",
  "servings": "4",
  "time": "50 min",
  "intro": "A high-protein bolognese in which lentils stretch the mince, lower the cost and make the sauce properly substantial. Tomatoes go in on top, unstirred, to avoid the “burn” warning.",
  "sections": [
   {
    "kind": "ingredients",
    "heading": "Ingredients",
    "items": [
     {
      "group": "Sauce base"
     },
     {
      "text": "600 g lean beef mince"
     },
     {
      "text": "¾ cup dry brown or green lentils, rinsed (or see the swaps below)"
     },
     {
      "text": "1 onion, diced"
     },
     {
      "text": "3 garlic cloves, crushed"
     },
     {
      "text": "1 cup beef stock"
     },
     {
      "text": "2 cans crushed tomatoes"
     },
     {
      "text": "2 tbsp tomato paste"
     },
     {
      "text": "1 tsp dried oregano"
     },
     {
      "text": "1 tsp dried basil"
     },
     {
      "text": "½ tsp dried thyme"
     },
     {
      "text": "¼ tsp dried rosemary, crushed"
     },
     {
      "text": "1 tsp smoked paprika"
     },
     {
      "text": "1 tsp Worcestershire sauce"
     },
     {
      "text": "Salt and pepper, to taste"
     },
     {
      "group": "To finish"
     },
     {
      "text": "400 g frozen mixed vegetables"
     },
     {
      "group": "To serve"
     },
     {
      "text": "350 g wholemeal or regular pasta"
     }
    ]
   },
   {
    "kind": "steps",
    "heading": "Method",
    "items": [
     {
      "text": "**Sauté the onion.** Select Sauté, add a small amount of oil and cook the onion for 3 minutes."
     },
     {
      "text": "**Brown the mince.** Add the mince and cook until browned, breaking it apart as it cooks."
     },
     {
      "text": "**Add the aromatics.** Stir in the garlic, oregano, basil, thyme, rosemary and paprika. Cook for another 30 seconds."
     },
     {
      "text": "**Deglaze.** Pour in the stock and scrape the base of the pot thoroughly."
     },
     {
      "text": "**Layer.** Stir in the lentils and Worcestershire sauce. Pour the crushed tomatoes and tomato paste over the top **without stirring**."
     },
     {
      "text": "**Pressure cook.** Lid on, valve sealed. Pressure Cook on High for **10 minutes**, then **natural release** for 10 minutes."
     },
     {
      "text": "**Finish.** Stir in the frozen vegetables and use Sauté for 5 minutes. Add a splash of water if the sauce is too thick. Season to taste."
     },
     {
      "text": "**Pasta.** Meanwhile, cook the pasta separately and divide into four servings. Top with the sauce."
     }
    ]
   },
   {
    "kind": "notes",
    "heading": "Notes",
    "items": [
     {
      "text": "Roughly 46–50 g protein per serving with 600 g mince (42–46 g at 500 g). The herb blend replaces 2 tsp of Italian herbs: oregano and basil carry the flavour, with thyme and rosemary kept light as they are stronger."
     }
    ]
   },
   {
    "kind": "variation",
    "heading": "Lentil swaps",
    "text": "**Canned brown lentils:** use 2 cans (400 g), drained and rinsed. They're already cooked, so leave them out of the pot: use only ½ cup stock, pressure cook for **5 minutes** with a 5-minute natural release, then stir the lentils in with the frozen vegetables. **Red lentils:** use ¾ cup dry split red lentils, rinsed, and add ½ cup extra water with the stock. Pressure cook for **8 minutes** with a 10-minute natural release. They melt into the sauce, so it's thicker and smoother, with less lentil texture.",
    "sections": []
   },
   {
    "kind": "variation",
    "heading": "Big Batch Sauce (6 serves)",
    "text": "For a week of meal prep, use 600 g lean beef mince and 1 cup dry split red lentils, 600 g frozen mixed vegetables plus 300 g frozen broccoli and cauliflower, 2 cans of tomatoes, 3 tbsp tomato paste, 1 cup water and 2 tbsp Italian herbs. Sauté the onion, garlic and mince, add everything else (vegetables before the tomatoes, unstirred), and pressure cook for **15 minutes** with a 10-minute natural release. Portion into 6 containers; cook pasta fresh for each meal (50–90 g dry per serve). Keeps 4 days in the fridge, or freeze.",
    "sections": []
   },
   {
    "kind": "variation",
    "heading": "Lentils Only",
    "text": "Leave out the mince and use 2½ cups dry split red lentils with the big-batch vegetables and 1½ cups water. Same timing. The lentils soften completely into the sauce.",
    "sections": []
   }
  ],
