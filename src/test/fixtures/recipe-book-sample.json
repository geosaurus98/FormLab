 {
  "title": "Lemon Herb Salmon Tray Bake",
  "servings": "6",
  "time": "10 min prep + 25 min",
  "intro": "",
  "sections": [
   {
    "kind": "ingredients",
    "heading": "Ingredients",
    "items": [
     {
      "text": "6 salmon fillets"
     },
     {
      "text": "1 bunch broccolini"
     },
     {
      "text": "1 bunch asparagus"
     },
     {
      "text": "250 g cherry tomatoes"
     },
     {
      "text": "2 tbsp olive oil"
     },
     {
      "text": "Zest and juice of 2 lemons"
     },
     {
      "text": "3 garlic cloves, minced"
     },
     {
      "text": "Fresh dill or mixed herbs"
     },
     {
      "text": "Salt and pepper"
     },
     {
      "text": "**To serve:** roasted baby potatoes"
     }
    ]
   },
   {
    "kind": "steps",
    "heading": "Method",
    "items": [
     {
      "text": "Preheat oven to 200°C."
     },
     {
      "text": "Toss broccolini, asparagus, and cherry tomatoes in olive oil, salt and pepper. Spread across a large baking tray."
     },
     {
      "text": "Place salmon fillets on top. Mix lemon zest, lemon juice, and garlic together and spoon over the salmon."
     },
     {
      "text": "Season with fresh dill, salt, and pepper."
     },
     {
      "text": "Bake for 20–25 minutes until salmon is cooked through and flakes easily."
     },
     {
      "text": "Serve with roasted baby potatoes."
     }
    ]
   },
   {
    "kind": "notes",
    "heading": "Notes",
    "items": [
     {
      "text": "**Tip:** Slightly pricier than other meals but worth it once a month. Watch for salmon on special at Pak'nSave or New World."
     }
    ]
   }
  ],
